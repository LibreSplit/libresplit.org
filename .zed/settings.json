{
    "hard_tabs": false,
    "tab_size": 4,
    "show_completions_on_input": true,
    "lsp": {
        "vtsls": {
            "settings": {
                "typescript": {
                    "preferences": {
                        "importModuleSpecifier": "non-relative"
                    }
                },
                "javascript": {
                    "preferences": {
                        "importModuleSpecifier": "non-relative"
                    }
                }
            }
        },
        "tailwindcss-language-server": {
            "settings": {
                "classAttributes": ["class"],
                "classFunctions": ["cn", "clsx", "cva"],
                "experimental": {
                    "configFile": "src/index.css"
                }
            }
        },
        "oxlint": {
            "initialization_options": {
                "settings": {
                    "configPath": "oxlint.config.ts",
                    "run": "onSave",
                    "fixKind": "safe_fix",
                    "unusedDisableDirectives": "deny",
                    "rulesCustomization": {
                        "no-unused-vars": {
                            "autofix": false
                        }
                    }
                }
            }
        },
        "oxfmt": {
            "initialization_options": {
                "settings": {
                    "fmt.configPath": ".oxfmtrc.json",
                    "run": "onSave"
                }
            }
        }
    },
    "languages": {
        "TypeScript": {
            "format_on_save": "on",
            "prettier": {
                "allowed": false
            },
            "formatter": [
                {
                    "language_server": {
                        "name": "oxfmt"
                    }
                },
                {
                    "code_action": "source.fixAll.oxc"
                }
            ]
        },
        "TSX": {
            "format_on_save": "on",
            "prettier": {
                "allowed": false
            },
            "formatter": [
                {
                    "language_server": {
                        "name": "oxfmt"
                    }
                },
                {
                    "code_action": "source.fixAll.oxc"
                }
            ]
        },
        "JavaScript": {
            "format_on_save": "on",
            "prettier": {
                "allowed": false
            },
            "formatter": [
                {
                    "language_server": {
                        "name": "oxfmt"
                    }
                },
                {
                    "code_action": "source.fixAll.oxc"
                }
            ]
        },
        "CSS": {
            "format_on_save": "on",
            "prettier": {
                "allowed": false
            },
            "language_servers": [
                "tailwindcss-intellisense-css",
                "!vscode-css-language-server",
                "..."
            ],
            "formatter": [
                {
                    "language_server": {
                        "name": "oxfmt"
                    }
                }
            ]
        },
        "HTML": {
            "format_on_save": "on",
            "prettier": {
                "allowed": false
            },
            "formatter": [
                {
                    "language_server": {
                        "name": "oxfmt"
                    }
                }
            ]
        },
        "JSON": {
            "format_on_save": "on",
            "prettier": {
                "allowed": false
            },
            "formatter": [
                {
                    "language_server": {
                        "name": "oxfmt"
                    }
                }
            ]
        },
        "JSONC": {
            "format_on_save": "on",
            "prettier": {
                "allowed": false
            },
            "formatter": [
                {
                    "language_server": {
                        "name": "oxfmt"
                    }
                }
            ]
        }
    }
}
